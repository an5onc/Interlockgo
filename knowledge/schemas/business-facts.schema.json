{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interlockgo.io/schemas/business-facts.schema.json",
  "title": "InterlockGo canonical business facts",
  "type": "object",
  "required": [
    "schemaVersion",
    "recordId",
    "publicBusinessName",
    "ownershipContext",
    "address",
    "phones",
    "hours",
    "holidayExceptions",
    "supportedProviders",
    "supportedDeviceModels",
    "services",
    "serviceAreas",
    "appointmentMethods",
    "pricing",
    "legalAndRegulatoryLimitations",
    "lastReviewedDate",
    "nextReviewDate",
    "responsibleOwner"
  ],
  "$defs": {
    "factStatus": {
      "enum": ["confirmed", "published-unverified", "needs-owner-confirmation", "external-conflict", "retired"]
    },
    "classification": {
      "enum": ["public", "staff-only", "restricted"]
    },
    "source": {
      "type": "object",
      "required": ["title", "url", "authorityLevel", "verifiedOn"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri"},
        "authorityLevel": {"enum": ["1-colorado-dmv", "2-provider", "3-interlockgo-policy", "4-verified-technician", "5-topic-signal"]},
        "verifiedOn": {"type": "string", "format": "date"}
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "recordId": {"const": "interlockgo-business-facts"},
    "publicBusinessName": {"type": "object"},
    "ownershipContext": {"type": "object"},
    "address": {"type": "object"},
    "phones": {"type": "array", "minItems": 1},
    "hours": {"type": "object"},
    "holidayExceptions": {"type": "array"},
    "supportedProviders": {"type": "array", "minItems": 1},
    "supportedDeviceModels": {"type": "array"},
    "services": {"type": "array", "minItems": 1},
    "serviceAreas": {"type": "array", "minItems": 1},
    "appointmentMethods": {"type": "array", "minItems": 1},
    "pricing": {"type": "object"},
    "legalAndRegulatoryLimitations": {"type": "array", "minItems": 1},
    "lastReviewedDate": {"type": "string", "format": "date"},
    "nextReviewDate": {"type": "string", "format": "date"},
    "responsibleOwner": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
