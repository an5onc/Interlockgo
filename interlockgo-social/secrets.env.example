# Copy this file to "secrets.env" and fill in your values. secrets.env is gitignored.

# From the Meta setup guide (setup-meta.md). Long-lived Page access token.
FB_PAGE_ACCESS_TOKEN=

# Your Facebook Page's numeric ID (setup-meta.md shows how to find it).
FB_PAGE_ID=

# Optional: Google AI Studio key for image generation (added later, not needed for text posts).
GOOGLE_AI_API_KEY=

# Local review server port (default 4500).
REVIEW_PORT=4500
